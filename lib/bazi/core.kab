@version "1.0.0"

// bazi/core — gameplay essentials (requires Kabootar game/ecs + input + physics).
// import "bazi/core"
import "game/ecs"
import "game/input"
import "game/physics"

pub fn createTransform(x, y, z) {
    if x == null || x == undefined { x = 0.0 }
    if y == null || y == undefined { y = 0.0 }
    if z == null || z == undefined { z = 0.0 }
    return { "kind": "Transform", "x": x, "y": y, "z": z, "yaw": 0.0 }
}

pub fn setTransformPos(t, x, y, z) {
    t["x"] = x
    t["y"] = y
    t["z"] = z
    return t
}

pub fn createHealth(current, maxHp) {
    if current == null || current == undefined { current = 100.0 }
    if maxHp == null || maxHp == undefined { maxHp = current }
    return { "kind": "Health", "current": current, "max": maxHp, "alive": current > 0.0 }
}

pub fn applyDamageToHealth(health, amount) {
    if amount == null || amount == undefined { amount = 0.0 }
    if amount < 0.0 { amount = 0.0 - amount }
    health["current"] = health["current"] - amount
    if health["current"] < 0.0 {
        health["current"] = 0.0
    }
    health["alive"] = health["current"] > 0.0
    return health
}

pub fn healHealth(health, amount) {
    if amount == null || amount == undefined { amount = 0.0 }
    health["current"] = health["current"] + amount
    if health["current"] > health["max"] {
        health["current"] = health["max"]
    }
    health["alive"] = health["current"] > 0.0
    return health
}

pub fn createDamage(amount, sourceId) {
    if amount == null || amount == undefined { amount = 10.0 }
    if sourceId == null || sourceId == undefined { sourceId = null }
    return { "kind": "Damage", "amount": amount, "sourceId": sourceId, "type": "raw" }
}

pub fn createMovement(speed) {
    if speed == null || speed == undefined { speed = 5.0 }
    return {
        "kind": "Movement",
        "speed": speed,
        "vx": 0.0,
        "vy": 0.0,
        "vz": 0.0,
        "wishX": 0.0,
        "wishZ": 0.0
    }
}

pub fn setMovementWish(mov, wishX, wishZ) {
    mov["wishX"] = wishX
    mov["wishZ"] = wishZ
    return mov
}

pub fn stepMovement(mov, transform, dt) {
    if dt == null || dt == undefined { dt = 0.016 }
    let sp = mov["speed"]
    mov["vx"] = mov["wishX"] * sp
    mov["vz"] = mov["wishZ"] * sp
    transform["x"] = transform["x"] + mov["vx"] * dt
    transform["z"] = transform["z"] + mov["vz"] * dt
    transform["y"] = transform["y"] + mov["vy"] * dt
    return { "movement": mov, "transform": transform }
}

pub fn createPlayerInput(actions) {
    if actions == null || actions == undefined {
        actions = {
            "left": ["KeyA", "ArrowLeft"],
            "right": ["KeyD", "ArrowRight"],
            "forward": ["KeyW", "ArrowUp"],
            "back": ["KeyS", "ArrowDown"],
            "jump": ["Space"],
            "attack": ["KeyF"]
        }
    }
    return {
        "kind": "PlayerInput",
        "actions": actions,
        "wishX": 0.0,
        "wishZ": 0.0,
        "jump": false,
        "attack": false
    }
}

pub fn samplePlayerInput(input) {
    let ax = 0.0
    let az = 0.0
    if actionPressed(input["actions"], "left") {
        ax = ax - 1.0
    }
    if actionPressed(input["actions"], "right") {
        ax = ax + 1.0
    }
    if actionPressed(input["actions"], "forward") {
        az = az - 1.0
    }
    if actionPressed(input["actions"], "back") {
        az = az + 1.0
    }
    input["wishX"] = ax
    input["wishZ"] = az
    input["jump"] = actionPressed(input["actions"], "jump")
    input["attack"] = actionPressed(input["actions"], "attack")
    return input
}

pub fn createCharacterController(x, y, z, radius, height) {
    if x == null || x == undefined { x = 0.0 }
    if y == null || y == undefined { y = 0.0 }
    if z == null || z == undefined { z = 0.0 }
    if radius == null || radius == undefined { radius = 0.4 }
    if height == null || height == undefined { height = 1.8 }
    return {
        "kind": "CharacterController",
        "x": x,
        "y": y,
        "z": z,
        "radius": radius,
        "height": height,
        "vy": 0.0,
        "grounded": false,
        "jumpSpeed": 6.0
    }
}

pub fn stepCharacterController(ctrl, mov, dt, gravity, groundBoxes, jumpPressed) {
    if dt == null || dt == undefined { dt = 0.016 }
    if gravity == null || gravity == undefined { gravity = -20.0 }
    if groundBoxes == null || groundBoxes == undefined { groundBoxes = [] }
    if jumpPressed == true && ctrl["grounded"] == true {
        ctrl["vy"] = ctrl["jumpSpeed"]
        ctrl["grounded"] = false
    }
    let wishX = 0.0
    let wishZ = 0.0
    if mov != null && mov != undefined {
        wishX = mov["wishX"] * mov["speed"]
        wishZ = mov["wishZ"] * mov["speed"]
    }
    let stepped = characterStep(ctrl, wishX, wishZ, dt, gravity, groundBoxes)
    stepped["kind"] = "CharacterController"
    stepped["jumpSpeed"] = ctrl["jumpSpeed"]
    return stepped
}

pub fn attachCoreBundle(world, id, x, y, z, hp, speed) {
    if x == null || x == undefined { x = 0.0 }
    if y == null || y == undefined { y = 0.0 }
    if z == null || z == undefined { z = 0.0 }
    if hp == null || hp == undefined { hp = 100.0 }
    if speed == null || speed == undefined { speed = 5.0 }
    world = add(world, id, "Transform", createTransform(x, y, z))
    world = add(world, id, "Health", createHealth(hp, hp))
    world = add(world, id, "Movement", createMovement(speed))
    world = add(world, id, "CharacterController", createCharacterController(x, y, z, 0.4, 1.8))
    return world
}
