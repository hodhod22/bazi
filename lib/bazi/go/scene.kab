@version "1.0.0"

// import "bazi/go/scene"
import "game/ecs"
import "bazi/go/ctx"

/// Scene = ECS world + dense behaviour list (cache-friendly tick).
pub fn createScene() {
    return {
        "kind": "Scene",
        "world": createWorld(),
        "behaviours": [],
        "names": {},
        "alive": {}
    }
}

pub fn sceneWorld(scene) {
    return scene["world"]
}

/// Spawn a GameObject. Returns { scene, id, name }.
pub fn spawnGo(scene, name) {
    if name == null || name == undefined { name = "Entity" }
    let world = scene["world"]
    let id = spawn(world)
    scene["world"] = world
    scene["names"]["" + id] = name
    scene["alive"]["" + id] = true
    world = add(world, id, "GameObject", {
        "kind": "GameObject",
        "id": id,
        "name": name,
        "active": true
    })
    scene["world"] = world
    return { "scene": scene, "id": id, "name": name }
}

pub fn goIsAlive(scene, id) {
    return scene["alive"]["" + id] == true
}

pub fn setGoActive(scene, id, active) {
    let world = scene["world"]
    let go = get(world, id, "GameObject")
    if go != null && go != undefined {
        go["active"] = active == true
        world = add(world, id, "GameObject", go)
        scene["world"] = world
    }
    let behaviours = scene["behaviours"]
    let i = 0
    while i < len(behaviours) {
        let b = behaviours[i]
        if b["id"] == id {
            b["enabled"] = active == true
            behaviours[i] = b
        }
        i = i + 1
    }
    scene["behaviours"] = behaviours
    return scene
}

/// Destroy GO: call onDestroy on lifecycle behaviours, then drop them.
pub fn destroyGo(scene, id) {
    let behaviours = scene["behaviours"]
    let world = scene["world"]
    let names = scene["names"]
    let name = names["" + id]
    if name == undefined || name == null { name = "" }
    let next = []
    let i = 0
    while i < len(behaviours) {
        let b = behaviours[i]
        if b["id"] == id {
            if b["fn"] != true && b["callDestroy"] == true {
                let ctx = {
                    "world": world,
                    "id": id,
                    "dt": 0.0,
                    "name": name,
                    "script": b["script"],
                    "get": goGet,
                    "set": goSet,
                    "has": goHas,
                    "done": goDone
                }
                let script = b["script"]
                ctx = script.onDestroy(ctx)
                world = ctx["world"]
            }
        } else {
            next = push(next, b)
        }
        i = i + 1
    }
    scene["behaviours"] = next
    scene["world"] = world
    scene["alive"]["" + id] = false
    let go = get(world, id, "GameObject")
    if go != null && go != undefined {
        go["active"] = false
        world = add(world, id, "GameObject", go)
        scene["world"] = world
    }
    return scene
}
