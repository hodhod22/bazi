@version "1.0.0"

// import "bazi/extras/vehicle"

pub fn createVehicle(x, z, speed, turnRate) {
    if x == null || x == undefined { x = 0.0 }
    if z == null || z == undefined { z = 0.0 }
    if speed == null || speed == undefined { speed = 12.0 }
    if turnRate == null || turnRate == undefined { turnRate = 2.5 }
    return {
        "kind": "Vehicle",
        "x": x,
        "y": 0.0,
        "z": z,
        "yaw": 0.0,
        "speed": speed,
        "turnRate": turnRate,
        "throttle": 0.0,
        "steer": 0.0
    }
}

pub fn setVehicleControls(v, throttle, steer) {
    v["throttle"] = throttle
    v["steer"] = steer
    return v
}

pub fn stepVehicle(v, dt) {
    if dt == null || dt == undefined { dt = 0.016 }
    v["yaw"] = v["yaw"] + v["steer"] * v["turnRate"] * dt
    let dist = v["throttle"] * v["speed"] * dt
    v["x"] = v["x"] + sin(v["yaw"]) * dist
    v["z"] = v["z"] - cos(v["yaw"]) * dist
    return v
}
