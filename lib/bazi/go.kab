@version "1.0.0"

// bazi/go - discovery aggregator. Games should prefer leaf imports
// (see docs/IMPORTS.md). Do not combine with bazi/go/systems + platform_use.
// AI systems: import "bazi/go/systems" separately (heavier).
pub import "bazi/go/scene"
pub import "bazi/go/component"
pub import "bazi/go/behaviour"
pub import "bazi/go/ctx"
pub import "bazi/go/tick"
pub import "bazi/go/query"
pub import "bazi/go/prefab"
pub import "bazi/go/playerStep"
