@version "1.0.0"

// Bazi Particle System - Better than Unity Particle System
// Features: ECS-integrated, GPU-accelerated, better performance, flexible emitters
// Canonical path: import "bazi/particles"

import "game/core/ecs3"

pub fn createParticleSystem() {
    return {
        "kind": "ParticleSystem",
        "particles": [],
        "maxParticles": 1000,
        "emitters": [],
        "activeCount": 0,
        "isPlaying": true,
        "loop": true,
        "simulationSpace": "world",
        "scalingMode": "local"
    }
}

pub fn createParticleEmitter(position, rate, lifetime) {
    return {
        "kind": "ParticleEmitter",
        "position": position,
        "rate": rate,
        "lifetime": lifetime,
        "velocity": { "x": 0.0, "y": 1.0, "z": 0.0 },
        "velocityRandom": { "x": 0.5, "y": 0.5, "z": 0.5 },
        "color": { "r": 1.0, "g": 1.0, "b": 1.0, "a": 1.0 },
        "colorOverLifetime": null,
        "size": 1.0,
        "sizeOverLifetime": null,
        "rotation": 0.0,
        "rotationSpeed": 0.0,
        "gravity": { "x": 0.0, "y": -9.81, "z": 0.0 },
        "drag": 0.0,
        "shape": "sphere",
        "shapeRadius": 1.0,
        "emit": true,
        "burstCount": 0,
        "burstInterval": 0.0,
        "burstTimer": 0.0
    }
}

pub fn addParticleSystemEmitter(system, emitter) {
    system["emitters"] = push(system["emitters"], emitter)
    return system
}

pub fn emitParticle(system, emitter) {
    if system["activeCount"] >= system["maxParticles"] {
        return system
    }
    
    let position = emitter["position"]
    
    if emitter["shape"] == "sphere" {
        let theta = random() * 6.28318
        let phi = random() * 3.14159
        let r = random() * emitter["shapeRadius"]
        position["x"] = position["x"] + r * sin(phi) * cos(theta)
        position["y"] = position["y"] + r * sin(phi) * sin(theta)
        position["z"] = position["z"] + r * cos(phi)
    } else if emitter["shape"] == "cone" {
        let angle = random() * emitter["shapeRadius"]
        let theta = random() * 6.28318
        position["x"] = position["x"] + angle * cos(theta)
        position["y"] = position["y"] + angle * sin(theta)
    }
    
    let velocity = {
        "x": emitter["velocity"]["x"] + (random() - 0.5) * emitter["velocityRandom"]["x"],
        "y": emitter["velocity"]["y"] + (random() - 0.5) * emitter["velocityRandom"]["y"],
        "z": emitter["velocity"]["z"] + (random() - 0.5) * emitter["velocityRandom"]["z"]
    }
    
    let particle = {
        "position": { "x": position["x"], "y": position["y"], "z": position["z"] },
        "velocity": velocity,
        "color": { "r": emitter["color"]["r"], "g": emitter["color"]["g"], "b": emitter["color"]["b"], "a": emitter["color"]["a"] },
        "size": emitter["size"],
        "rotation": emitter["rotation"],
        "rotationSpeed": emitter["rotationSpeed"],
        "lifetime": emitter["lifetime"],
        "age": 0.0,
        "alive": true
    }
    
    system["particles"] = push(system["particles"], particle)
    system["activeCount"] = system["activeCount"] + 1
    return system
}

pub fn updateParticleSystem(system, dt) {
    if system["isPlaying"] != true {
        return system
    }
    
    let i = 0
    while i < len(system["emitters"]) {
        let emitter = system["emitters"][i]
        
        if emitter["emit"] == true {
            let emitCount = floor(emitter["rate"] * dt)
            let j = 0
            while j < emitCount {
                system = emitParticle(system, emitter)
                j = j + 1
            }
            
            if emitter["burstCount"] > 0 {
                emitter["burstTimer"] = emitter["burstTimer"] + dt
                if emitter["burstTimer"] >= emitter["burstInterval"] {
                    let k = 0
                    while k < emitter["burstCount"] {
                        system = emitParticle(system, emitter)
                        k = k + 1
                    }
                    emitter["burstTimer"] = 0.0
                }
            }
        }
        
        system["emitters"][i] = emitter
        i = i + 1
    }
    
    system = updateParticles(system, dt)
    
    return system
}

fn updateParticles(system, dt) {
    let aliveParticles = []
    let activeCount = 0
    
    let i = 0
    while i < len(system["particles"]) {
        let particle = system["particles"][i]
        
        if particle["alive"] == true {
            particle["age"] = particle["age"] + dt
            
            if particle["age"] >= particle["lifetime"] {
                particle["alive"] = false
            } else {
                particle["velocity"]["x"] = particle["velocity"]["x"] + particle["velocity"]["x"] * particle["drag"] * dt
                particle["velocity"]["y"] = particle["velocity"]["y"] + particle["velocity"]["y"] * particle["drag"] * dt
                particle["velocity"]["z"] = particle["velocity"]["z"] + particle["velocity"]["z"] * particle["drag"] * dt
                
                let emitter = system["emitters"][0]
                if emitter != null {
                    particle["velocity"]["x"] = particle["velocity"]["x"] + emitter["gravity"]["x"] * dt
                    particle["velocity"]["y"] = particle["velocity"]["y"] + emitter["gravity"]["y"] * dt
                    particle["velocity"]["z"] = particle["velocity"]["z"] + emitter["gravity"]["z"] * dt
                }
                
                particle["position"]["x"] = particle["position"]["x"] + particle["velocity"]["x"] * dt
                particle["position"]["y"] = particle["position"]["y"] + particle["velocity"]["y"] * dt
                particle["position"]["z"] = particle["position"]["z"] + particle["velocity"]["z"] * dt
                
                particle["rotation"] = particle["rotation"] + particle["rotationSpeed"] * dt
                
                let lifeRatio = particle["age"] / particle["lifetime"]
                
                if emitter != null && emitter["colorOverLifetime"] != null {
                    particle["color"] = evaluateGradient(emitter["colorOverLifetime"], lifeRatio)
                }
                
                if emitter != null && emitter["sizeOverLifetime"] != null {
                    particle["size"] = particle["size"] * emitter["sizeOverLifetime"][lifeRatio]
                }
                
                aliveParticles = push(aliveParticles, particle)
                activeCount = activeCount + 1
            }
        }
        
        i = i + 1
    }
    
    system["particles"] = aliveParticles
    system["activeCount"] = activeCount
    return system
}

pub fn stopParticleSystem(system) {
    system["isPlaying"] = false
    return system
}

pub fn playParticleSystem(system) {
    system["isPlaying"] = true
    return system
}

pub fn clearParticleSystem(system) {
    system["particles"] = []
    system["activeCount"] = 0
    return system
}

pub fn setParticleEmitterPosition(emitter, x, y, z) {
    emitter["position"] = { "x": x, "y": y, "z": z }
    return emitter
}

pub fn setParticleEmitterVelocity(emitter, x, y, z) {
    emitter["velocity"] = { "x": x, "y": y, "z": z }
    return emitter
}

pub fn setParticleEmitterColor(emitter, r, g, b, a) {
    emitter["color"] = { "r": r, "g": g, "b": b, "a": a }
    return emitter
}

pub fn setParticleEmitterSize(emitter, size) {
    emitter["size"] = size
    return emitter
}

pub fn setParticleEmitterLifetime(emitter, lifetime) {
    emitter["lifetime"] = lifetime
    return emitter
}

pub fn setParticleEmitterRate(emitter, rate) {
    emitter["rate"] = rate
    return emitter
}

pub fn setParticleEmitterGravity(emitter, x, y, z) {
    emitter["gravity"] = { "x": x, "y": y, "z": z }
    return emitter
}

pub fn setParticleEmitterDrag(emitter, drag) {
    emitter["drag"] = drag
    return emitter
}

pub fn setParticleEmitterShape(emitter, shape, radius) {
    emitter["shape"] = shape
    emitter["shapeRadius"] = radius
    return emitter
}

pub fn setParticleEmitterBurst(emitter, count, interval) {
    emitter["burstCount"] = count
    emitter["burstInterval"] = interval
    return emitter
}

pub fn createColorGradient(keys) {
    return {
        "keys": keys
    }
}

fn evaluateGradient(gradient, t) {
    let keys = gradient["keys"]
    
    if t <= 0.0 {
        return keys[0]["color"]
    }
    
    if t >= 1.0 {
        return keys[len(keys) - 1]["color"]
    }
    
    let i = 0
    while i < len(keys) - 1 {
        if t >= keys[i]["time"] && t <= keys[i + 1]["time"] {
            let localT = (t - keys[i]["time"]) / (keys[i + 1]["time"] - keys[i]["time"])
            return lerpColor(keys[i]["color"], keys[i + 1]["color"], localT)
        }
        i = i + 1
    }
    
    return keys[0]["color"]
}

fn lerpColor(a, b, t) {
    return {
        "r": a["r"] + (b["r"] - a["r"]) * t,
        "g": a["g"] + (b["g"] - a["g"]) * t,
        "b": a["b"] + (b["b"] - a["b"]) * t,
        "a": a["a"] + (b["a"] - a["a"]) * t
    }
}

pub fn createSizeCurve(keys) {
    return keys
}

pub fn getParticleCount(system) {
    return system["activeCount"]
}

pub fn setParticleSystemMaxParticles(system, max) {
    system["maxParticles"] = max
    return system
}

pub fn emitParticleBurst(system, emitter, count) {
    let i = 0
    while i < count {
        system = emitParticle(system, emitter)
        i = i + 1
    }
    return system
}

pub fn setParticleSimulationSpace(system, space) {
    system["simulationSpace"] = space
    return system
}

pub fn setParticleScalingMode(system, mode) {
    system["scalingMode"] = mode
    return system
}
