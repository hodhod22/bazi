@version "1.0.0"

// import "bazi/ai/stateMachine"

/// states: [{ "id", "onEnter"?, "onUpdate"? }] — callbacks optional (string tags).
pub fn createStateMachine(states, startId) {
    if startId == null || startId == undefined {
        startId = states[0]["id"]
    }
    return {
        "kind": "StateMachine",
        "states": states,
        "current": startId,
        "elapsed": 0.0,
        "prev": null
    }
}

pub fn smTransition(sm, nextId) {
    sm["prev"] = sm["current"]
    sm["current"] = nextId
    sm["elapsed"] = 0.0
    return sm
}

pub fn stepStateMachine(sm, dt) {
    if dt == null || dt == undefined { dt = 0.016 }
    sm["elapsed"] = sm["elapsed"] + dt
    return sm
}

pub fn smIs(sm, id) {
    return sm["current"] == id
}
